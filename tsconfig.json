{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "src/middleware.ts",
    ".resources/_Cta.tsx"
, ".resources/_SearchBar.tsx", "src/components/.SearchBar.tsx", "src/components/12_BackNav.tsx", "src/components/Container.tsx", ".resources/Ctas.tsx", ".resources/Legal.tsx", ".resources/Faq.tsx", ".resources/TrustBadges.tsx"  ],
  "exclude": ["node_modules"]
}
